[Unit]
Description=VPN/proxy subscription Telegram bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/vpn-bot
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
User=vpnbot
Environment=BOT_TOKEN=123456:AAExampleTokenReplaceMe
Environment=STORE_PATH=/opt/vpn-bot/data/store.json
Environment=PROXY_HOST=203.0.113.10
Environment=PROXY_HTTP_PORT=8080
Environment=PROXY_SOCKS_PORT=1080
Environment=ADMIN_IDS=123456789
# Environment=PROVIDER_TOKEN=

[Install]
WantedBy=multi-user.target
