# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:AAExampleTokenReplaceMe

# Необязательно: токен платёжного провайдера (например, ЮKassa) от @BotFather
# (/mybots -> бот -> Payments). Если не задан — оплата через Telegram Stars,
# работает без какой-либо дополнительной настройки.
# PROVIDER_TOKEN=

# Куда положить общий JSON-файл с пользователями/подписками.
# web-proxy должен указывать на этот же путь через SUBSCRIPTIONS_FILE.
STORE_PATH=./data/store.json

# Адрес и порты web-proxy, которые бот показывает пользователю в личном кабинете.
PROXY_HOST=203.0.113.10
PROXY_HTTP_PORT=8080
PROXY_SOCKS_PORT=1080

# Telegram ID администраторов через запятую — им доступна команда /grant
# для ручной выдачи подписки.
ADMIN_IDS=

# Необязательно: юзернейм поддержки, показывается пользователям при ошибках.
# SUPPORT_USERNAME=

# HTTP API для Android-приложения (../android-app/).
API_HOST=0.0.0.0
API_PORT=3000

# Юзернейм бота без @, для deep link'ов из API (t.me/<bot>?start=...).
# Если не задан — определяется автоматически при старте через getMe().
# BOT_USERNAME=MyVpnBot
