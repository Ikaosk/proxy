# Быстрый вариант — один пользователь без config.json (см. config.example.json
# для варианта с несколькими пользователями).
PROXY_USER=myuser
PROXY_PASSWORD=change-me-to-a-strong-password

PROXY_LISTEN_HOST=0.0.0.0
PROXY_HTTP_PORT=8080
PROXY_SOCKS_PORT=1080

# Чтобы доступ проверялся по подписке из telegram-bot — путь к тому же
# store.json, что указан в telegram-bot/.env как STORE_PATH.
# SUBSCRIPTIONS_FILE=../telegram-bot/data/store.json
